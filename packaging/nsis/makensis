#!/bin/sh
# Runs makensis from the dsync-nsis Docker image, with the project mounted at
# the same path so the paths Wails passes still work. Builds the image the
# first time.
set -e
root=$(cd "$(dirname "$0")/../.." && pwd)
# Tagged by the Dockerfile's hash, so a changed Dockerfile builds a new image.
image="dsync-nsis:$(sha256sum "$root/packaging/nsis/Dockerfile" | cut -c1-12)"
if ! docker image inspect "$image" >/dev/null 2>&1; then
	docker build -q -t "$image" "$root/packaging/nsis" >&2
fi
exec docker run --rm -u "$(id -u):$(id -g)" -v "$root:$root" -w "$PWD" "$image" "$@"
