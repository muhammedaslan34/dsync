#!/bin/sh
# Runs makensis from the dsync-nsis Docker image, with the project mounted at
# the same path so the paths Wails passes still work. Builds the image the
# first time.
set -e
root=$(cd "$(dirname "$0")/../.." && pwd)
if ! docker image inspect dsync-nsis >/dev/null 2>&1; then
	docker build -q -t dsync-nsis "$root/packaging/nsis" >&2
fi
exec docker run --rm -u "$(id -u):$(id -g)" -v "$root:$root" -w "$PWD" dsync-nsis "$@"
