{
  "expo": {
    "name": "dsync",
    "slug": "dsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "dsync uses the camera to scan the pairing code shown on your computer.",
        "NSLocalNetworkUsageDescription": "dsync talks to dsync on your computers over the local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5b5bd6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "dsync uses the camera to scan the pairing code shown on your computer.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-font"
    ],
    "backgroundColor": "#f7f7f9"
  }
}
