{
  "expo": {
    "name": "dsync",
    "slug": "dsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "io.github.muhammedaslan34.dsync",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "dsync uses the camera to scan the pairing code shown on your computer or another phone.",
        "NSLocalNetworkUsageDescription": "dsync talks to dsync on your computers and other phones over the local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "io.github.muhammedaslan34.dsync",
      "adaptiveIcon": {
        "backgroundColor": "#5b5bd6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "dsync uses the camera to scan the pairing code shown on your computer or another phone.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#f7f7f9",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0f0f14"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "supportedLocales": {
            "ios": [
              "en",
              "ar",
              "tr",
              "fr"
            ],
            "android": [
              "en",
              "ar",
              "tr",
              "fr"
            ]
          }
        }
      ]
    ],
    "backgroundColor": "#f7f7f9",
    "scheme": "dsync-mobile",
    "locales": {
      "en": "./locales/en.json",
      "ar": "./locales/ar.json",
      "tr": "./locales/tr.json",
      "fr": "./locales/fr.json"
    }
  }
}
